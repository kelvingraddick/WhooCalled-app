# Server-only Firebase Functions configuration. Set these through Firebase
# parameter/secret management for production; do not commit their values.
ENFORCE_APP_CHECK=true
LOOKUP_PROVIDER_CONFIGURED=false
ENABLE_BRAVE_SEARCH_FALLBACK=false
GOOGLE_GROUNDING_MODEL=gemini-3.5-flash-lite
GOOGLE_GROUNDING_PROJECT_ID=whoo-called
# Product IDs and grants for the Whoo Called iOS catalog. Set the real value
# through Firebase parameter management, never in a committed .env file.
CREDIT_PRODUCT_MAP={"com.wavelinkllc.whoocalled.plus.monthly":{"monthlyAllowance":15,"planName":"Plus"},"com.wavelinkllc.whoocalled.plus.annual":{"monthlyAllowance":15,"planName":"Plus"},"com.wavelinkllc.whoocalled.pro.monthly":{"monthlyAllowance":35,"planName":"Pro"},"com.wavelinkllc.whoocalled.pro.annual":{"monthlyAllowance":35,"planName":"Pro"},"com.wavelinkllc.whoocalled.power.monthly":{"monthlyAllowance":60,"planName":"Power"},"com.wavelinkllc.whoocalled.power.annual":{"monthlyAllowance":60,"planName":"Power"},"com.wavelinkllc.whoocalled.credits.5":{"credits":5},"com.wavelinkllc.whoocalled.credits.20":{"credits":20},"com.wavelinkllc.whoocalled.credits.10":{"credits":10},"com.wavelinkllc.whoocalled.credits.25":{"credits":25},"com.wavelinkllc.whoocalled.credits.50":{"credits":50}}
# Comma-separated Firebase Auth emails that may use hidden tester Debug tools.
# Keep this empty until specific tester accounts are approved.
DEBUG_TESTER_EMAILS=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
