{
  "name": "whoo-called",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "functions"
  ],
  "scripts": {
    "android": "react-native run-android --port 8088",
    "ios": "react-native run-ios --port 8088",
    "lint": "eslint .",
    "start": "react-native start --port 8088",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "validate:release-config": "node scripts/validate-release-config.mjs",
    "functions:build": "npm run build --workspace whoo-called-functions",
    "functions:test": "npm run test --workspace whoo-called-functions",
    "emulators": "firebase emulators:start --only auth,firestore,functions",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/firestore.rules.test.mjs\""
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-firebase/analytics": "^26.3.3",
    "@react-native-firebase/app": "^26.3.3",
    "@react-native-firebase/auth": "^26.3.3",
    "@react-native-firebase/firestore": "^26.3.3",
    "@react-native-firebase/functions": "^26.3.3",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-native-vector-icons/ionicons": "^13.1.3",
    "@react-native/new-app-screen": "0.87.1",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-config": "^1.7.2",
    "react-native-device-info": "^15.0.2",
    "react-native-get-random-values": "^2.0.0",
    "react-native-purchases": "^10.8.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-webview": "^14.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "firebase": "^12.18.0",
    "firebase-tools": "^15.28.2",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-asset": "^2.3.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
